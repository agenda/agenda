{
  "name": "agenda-rest",
  "version": "6.1.5",
  "description": "REST API for Agenda job scheduling",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agenda-rest": "./bin/agenda-rest.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node bin/agenda-rest.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/agenda/agenda"
  },
  "keywords": [
    "agenda",
    "rest",
    "api",
    "job",
    "scheduler"
  ],
  "license": "MIT",
  "dependencies": {
    "@agendajs/mongo-backend": "workspace:*",
    "agenda": "workspace:*",
    "commander": "^12.1.0",
    "koa": "^2.16.4",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^13.1.1"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-router": "^7.4.9",
    "@types/node": "^25.6.2",
    "@types/supertest": "^6.0.3",
    "mongodb": "^6.21.0",
    "mongodb-memory-server": "^11.1.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5"
  },
  "private": true
}
