{
  "name": "agendash",
  "version": "8.2.3",
  "description": "Dashboard for Agenda job scheduler",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "public"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsc -b && vite build --config client/vite.config.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "dev": "tsx dev-server.ts",
    "dev:postgres": "tsx dev-server-postgres.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/agenda/agenda"
  },
  "keywords": [
    "agenda",
    "dashboard",
    "job",
    "scheduler",
    "admin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@fastify/static": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "@hapi/hapi": "^21.0.0",
    "@hapi/inert": "^7.0.0",
    "agenda": "workspace:*",
    "express": "^4.18.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0",
    "koa": "^2.14.0 || ^3.0.0",
    "koa-bodyparser": "^4.4.0",
    "koa-router": "^12.0.0 || ^13.0.0",
    "koa-static": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "koa": {
      "optional": true
    },
    "koa-router": {
      "optional": true
    },
    "koa-static": {
      "optional": true
    },
    "koa-bodyparser": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@fastify/static": {
      "optional": true
    },
    "@hapi/hapi": {
      "optional": true
    },
    "@hapi/inert": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agendajs/mongo-backend": "workspace:*",
    "@agendajs/postgres-backend": "workspace:*",
    "@fastify/static": "^8.3.0",
    "@hapi/hapi": "^21.4.9",
    "@hapi/inert": "^7.1.0",
    "@types/express": "^4.17.25",
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-router": "^7.4.9",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^22.19.18",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "agenda": "workspace:*",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.1.0",
    "express": "^4.22.1",
    "fastify": "^5.8.5",
    "koa": "^2.16.4",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^13.1.1",
    "koa-static": "^5.0.0",
    "mongodb": "^6.21.0",
    "mongodb-memory-server": "^10.4.3",
    "pg": "^8.20.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.34",
    "vue-tsc": "^2.2.12"
  }
}
